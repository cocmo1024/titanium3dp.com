---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Image from '~/components/common/Image.astro';
import type { Steps as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  image = await Astro.slots.render('image'),
  isReversed = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const hasHeader = title || subtitle || tagline;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  {
    hasHeader && (
      <div class="mb-8 grid gap-3 border-y border-page-border py-6 md:grid-cols-[0.36fr_0.64fr] md:items-end md:gap-10">
        <div>
          {tagline && (
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-primary" set:html={tagline} />
          )}
          {title && <h2 class="text-2xl font-bold tracking-tight text-heading md:text-3xl" set:html={title} />}
        </div>
        {subtitle && <p class="max-w-2xl text-sm leading-6 text-muted" set:html={subtitle} />}
      </div>
    )
  }

  <div class={image ? 'grid gap-10 md:grid-cols-2 md:gap-16' : 'w-full'}>
    <div class:list={['self-center', { 'md:order-2': image && isReversed }, { 'w-full': !image }]}>
      <Timeline items={items} classes={classes?.items as Record<string, never>} />
    </div>
    {
      image && (
        <div class:list={['self-center', { 'md:order-1': isReversed }]}>
          {typeof image === 'string' ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="mx-auto w-full rounded-md bg-surface-raised"
              widths={[400, 768]}
              sizes="(max-width: 768px) 100vw, 432px"
              width={500}
              height={500}
              layout="responsive"
              src={image?.src}
              alt={image?.alt || ''}
            />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
