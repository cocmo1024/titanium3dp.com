---
// Turnstile site keys are public identifiers. Keep the Cloudflare build variable
// as the override, with the production widget as a safe fallback for Git builds.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAD1IsOhMIIWtxkf6';

const fieldClass =
  'mt-2 block w-full rounded-md border border-control-border bg-page px-3 py-2.5 text-default shadow-sm outline-none transition placeholder:text-muted/70 focus:border-primary focus:ring-2 focus:ring-focus';
const labelClass = 'block text-sm font-semibold text-heading';
---

<section id="rfq-form" class="scroll-mt-24 border-y border-page-border bg-surface py-12 md:py-16">
  <div class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
    <div>
      <p class="text-sm font-semibold text-accent">Secure titanium RFQ submission</p>
      <h2 class="mt-2 font-heading text-3xl font-bold text-heading">
        Submit the files needed for an engineering review
      </h2>
      <p class="mt-4 leading-7 text-muted">
        Include enough detail to evaluate titanium material, process fit, post-processing, inspection, and quotation
        scope. Unknown items can be marked as not decided. A confirmation appears only after the secure submission
        service accepts the request.
      </p>
      <ul class="mt-6 grid gap-3 text-sm leading-6 text-muted">
        <li><strong class="text-heading">Useful files:</strong> STEP/STP, X_T/X_B, IGES, STL, 3MF, PDF, or images.</li>
        <li><strong class="text-heading">Upload limit:</strong> up to 3 files, 5 MB each, 8 MB total.</li>
        <li>
          <strong class="text-heading">Sensitive projects:</strong> do not send export-controlled, classified, medical-regulated,
          or otherwise restricted data before an approved handling agreement is in place.
        </li>
      </ul>
      <p class="mt-6 text-sm leading-6 text-muted">
        Prefer email? Send the package to
        <a class="font-semibold text-link hover:underline" href="mailto:info@szcomo.com">info@szcomo.com</a>.
      </p>
    </div>

    <div class="rounded-md border border-page-border bg-page p-5 shadow-panel sm:p-7">
      <form
        action="/api/rfq"
        method="post"
        enctype="multipart/form-data"
        data-rfq-form
        data-turnstile-site-key={turnstileSiteKey}
        novalidate
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <label class={labelClass}>
            Your name <span class="text-accent" aria-hidden="true">*</span>
            <input class={fieldClass} name="name" type="text" autocomplete="name" maxlength="80" required />
          </label>

          <label class={labelClass}>
            Work email <span class="text-accent" aria-hidden="true">*</span>
            <input class={fieldClass} name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>

          <label class={labelClass}>
            Company <span class="text-accent" aria-hidden="true">*</span>
            <input class={fieldClass} name="company" type="text" autocomplete="organization" maxlength="120" required />
          </label>

          <label class={labelClass}>
            Country or region
            <input class={fieldClass} name="country" type="text" autocomplete="country-name" maxlength="80" />
          </label>

          <label class={labelClass}>
            Application <span class="text-accent" aria-hidden="true">*</span>
            <!-- Keep option values explicit: browser translation may rewrite labels, never submitted values. -->
            <select class={fieldClass} name="application" required>
              <option value="">Select the closest fit</option>
              <option value="Aerospace, space, or eVTOL">Aerospace, space, or eVTOL</option>
              <option value="Medical, dental, or implant">Medical, dental, or implant</option>
              <option value="Industrial, robotics, or automation">Industrial, robotics, or automation</option>
              <option value="Energy, hydrogen, or process equipment">Energy, hydrogen, or process equipment</option>
              <option value="Marine, subsea, or corrosive service">Marine, subsea, or corrosive service</option>
              <option value="Heat exchanger, manifold, or flow component">
                Heat exchanger, manifold, or flow component
              </option>
              <option value="Motorsport or mobility">Motorsport or mobility</option>
              <option value="Other titanium AM part">Other titanium AM part</option>
            </select>
          </label>

          <label class={labelClass}>
            Titanium material <span class="text-accent" aria-hidden="true">*</span>
            <select class={fieldClass} name="material" required>
              <option value="Not decided">Not decided</option>
              <option value="Ti-6Al-4V / TC4 / Grade 5">Ti-6Al-4V / TC4 / Grade 5</option>
              <option value="Ti-6Al-4V ELI / Grade 23">Ti-6Al-4V ELI / Grade 23</option>
              <option value="CP Titanium Grade 1 / TA1">CP Titanium Grade 1 / TA1</option>
              <option value="CP Titanium Grade 2 / TA2">CP Titanium Grade 2 / TA2</option>
              <option value="Other titanium alloy">Other titanium alloy</option>
            </select>
          </label>

          <label class={labelClass}>
            Prototype / production quantity <span class="text-accent" aria-hidden="true">*</span>
            <input
              class={fieldClass}
              name="quantity"
              type="text"
              inputmode="text"
              maxlength="80"
              placeholder="Example: 2 prototypes; 50/year"
              required
            />
          </label>

          <label class={labelClass}>
            Project timing <span class="text-accent" aria-hidden="true">*</span>
            <select class={fieldClass} name="timing" required>
              <option value="Exploring feasibility">Exploring feasibility</option>
              <option value="Quote needed within 2 weeks">Quote needed within 2 weeks</option>
              <option value="Prototype needed within 1–2 months">Prototype needed within 1–2 months</option>
              <option value="Production planning">Production planning</option>
            </select>
          </label>
        </div>

        <label class={`${labelClass} mt-5`}>
          Requirements and acceptance criteria <span class="text-accent" aria-hidden="true">*</span>
          <textarea
            class={fieldClass}
            name="requirements"
            rows="7"
            minlength="30"
            maxlength="4000"
            placeholder="Describe the part, function, operating conditions, critical datums or surfaces, process preference, post-processing, inspection evidence, documentation, and target lead time."
            required></textarea>
        </label>

        <label class={`${labelClass} mt-5`}>
          CAD, drawings, or reference files
          <input
            class={`${fieldClass} file:mr-4 file:rounded file:border-0 file:bg-surface-raised file:px-3 file:py-2 file:text-sm file:font-semibold file:text-heading`}
            name="attachments"
            type="file"
            accept=".pdf,.step,.stp,.stl,.3mf,.iges,.igs,.x_t,.x_b,.jpg,.jpeg,.png"
            multiple
            data-rfq-files
          />
          <span class="mt-2 block text-xs font-normal leading-5 text-muted" data-rfq-file-help>
            Optional. Large or controlled file packages should be arranged by email first.
          </span>
        </label>

        <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
          <label>
            Website
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <input name="started_at" type="hidden" value="" />
        <input name="submission_id" type="hidden" value="" />
        <input name="source_page" type="hidden" value="" />
        <input name="attribution" type="hidden" value="" />

        {
          turnstileSiteKey ? (
            <div class="mt-5">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="auto"
                data-size="flexible"
                data-action="rfq_submit"
              />
            </div>
          ) : (
            <p class="mt-5 rounded-md border border-amber-400/40 bg-amber-100/10 px-3 py-2 text-xs leading-5 text-muted">
              Secure submission is awaiting its production security key. Email info@szcomo.com if the form is
              unavailable.
            </p>
          )
        }

        <label class="mt-5 flex items-start gap-3 text-sm leading-6 text-muted">
          <input
            class="mt-1 h-4 w-4 shrink-0 rounded border-control-border text-primary focus:ring-focus"
            name="consent"
            type="checkbox"
            value="accepted"
            required
          />
          <span>
            I confirm that this information may be used to evaluate and respond to my RFQ and, where permitted, to
            measure advertising conversions under the
            <a
              class="font-semibold text-link hover:underline"
              href="/privacy/"
              target="_blank"
              rel="noopener noreferrer">Privacy Policy</a
            >.
          </span>
        </label>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-focus disabled:cursor-not-allowed disabled:opacity-60"
            type="submit"
            data-rfq-submit
            disabled={!turnstileSiteKey}
          >
            Submit secure RFQ
          </button>
          <p class="text-sm leading-6 text-muted" aria-live="polite" data-rfq-status>
            {turnstileSiteKey ? '' : 'Online submission is unavailable. Please email info@szcomo.com.'}
          </p>
        </div>
      </form>

      <div class="hidden rounded-md border border-emerald-500/40 bg-emerald-500/10 p-5" role="status" data-rfq-success>
        <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">RFQ submitted</p>
        <h3 class="mt-2 font-heading text-2xl font-bold text-heading">Your project is ready for engineering review</h3>
        <p class="mt-3 leading-7 text-muted">
          A reference is shown below. Keep it for follow-up, and check your inbox for replies from info@szcomo.com.
        </p>
        <p class="mt-4 font-mono text-sm text-heading" data-rfq-reference></p>
      </div>
    </div>
  </div>
</section>

{turnstileSiteKey ? <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" /> : null}

<script is:inline>
  (() => {
    const form = document.querySelector('[data-rfq-form]');
    if (!form || form.dataset.rfqBound === 'true') return;
    form.dataset.rfqBound = 'true';

    const submitButton = form.querySelector('[data-rfq-submit]');
    const status = form.querySelector('[data-rfq-status]');
    const fileInput = form.querySelector('[data-rfq-files]');
    const fileHelp = form.querySelector('[data-rfq-file-help]');
    const successPanel = form.parentElement?.querySelector('[data-rfq-success]');
    const reference = successPanel?.querySelector('[data-rfq-reference]');
    const applicationSelect = form.elements.namedItem('application');
    const sourcePage = form.elements.namedItem('source_page');
    const startedAt = form.elements.namedItem('started_at');
    const submissionId = form.elements.namedItem('submission_id');
    const attributionInput = form.elements.namedItem('attribution');
    const defaultSubmitText = submitButton?.textContent?.trim() || 'Submit secure RFQ';

    const applicationHints = {
      aerospace: 'Aerospace, space, or eVTOL',
      aircraft: 'Aerospace, space, or eVTOL',
      space: 'Aerospace, space, or eVTOL',
      evtol: 'Aerospace, space, or eVTOL',
      medical: 'Medical, dental, or implant',
      dental: 'Medical, dental, or implant',
      implant: 'Medical, dental, or implant',
      robot: 'Industrial, robotics, or automation',
      automation: 'Industrial, robotics, or automation',
      energy: 'Energy, hydrogen, or process equipment',
      hydrogen: 'Energy, hydrogen, or process equipment',
      process: 'Energy, hydrogen, or process equipment',
      marine: 'Marine, subsea, or corrosive service',
      subsea: 'Marine, subsea, or corrosive service',
      corrosion: 'Marine, subsea, or corrosive service',
      'heat exchanger': 'Heat exchanger, manifold, or flow component',
      manifold: 'Heat exchanger, manifold, or flow component',
      flow: 'Heat exchanger, manifold, or flow component',
      motorsport: 'Motorsport or mobility',
      racing: 'Motorsport or mobility',
    };

    const allowedFileMimeTypes = {
      '.pdf': ['application/pdf', 'application/x-pdf', 'application/octet-stream'],
      '.step': ['model/step', 'application/step', 'application/vnd.step', 'application/octet-stream', 'text/plain'],
      '.stp': ['model/step', 'application/step', 'application/vnd.step', 'application/octet-stream', 'text/plain'],
      '.stl': ['model/stl', 'application/sla', 'application/vnd.ms-pki.stl', 'application/octet-stream', 'text/plain'],
      '.3mf': [
        'model/3mf',
        'application/vnd.ms-package.3dmanufacturing-3dmodel+xml',
        'application/vnd.ms-3mfdocument',
        'application/zip',
        'application/octet-stream',
      ],
      '.iges': ['model/iges', 'application/iges', 'application/octet-stream', 'text/plain'],
      '.igs': ['model/iges', 'application/iges', 'application/octet-stream', 'text/plain'],
      '.x_t': ['application/x-parasolid', 'application/octet-stream', 'text/plain'],
      '.x_b': ['application/x-parasolid', 'application/octet-stream'],
      '.jpg': ['image/jpeg', 'image/pjpeg', 'image/jpg'],
      '.jpeg': ['image/jpeg', 'image/pjpeg', 'image/jpg'],
      '.png': ['image/png'],
    };

    function setStatus(message, isError = false) {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('text-red-600', isError);
      status.classList.toggle('dark:text-red-400', isError);
    }

    function readAttribution() {
      if (typeof window.TITANIUM3DP_GET_ATTRIBUTION === 'function') {
        return window.TITANIUM3DP_GET_ATTRIBUTION() || {};
      }

      try {
        return JSON.parse(sessionStorage.getItem('TITANIUM3DP_attribution') || '{}');
      } catch {
        return {};
      }
    }

    function refreshContext(resetStartedAt = false) {
      if (resetStartedAt && startedAt) startedAt.value = String(Date.now());
      if (submissionId && !submissionId.value) submissionId.value = crypto.randomUUID();
      if (sourcePage) sourcePage.value = window.location.href;
      if (attributionInput) attributionInput.value = JSON.stringify(readAttribution());

      const hint = new URLSearchParams(window.location.search).get('project')?.toLowerCase() || '';
      const match = Object.entries(applicationHints).find(([key]) => hint.includes(key));
      if (match && applicationSelect) applicationSelect.value = match[1];
    }

    function getExtension(name) {
      const normalizedName = String(name || '').toLowerCase();
      const lastDot = normalizedName.lastIndexOf('.');
      return lastDot >= 0 ? normalizedName.slice(lastDot) : '';
    }

    function normalizeMimeType(value) {
      return (
        String(value || '')
          .split(';', 1)[0]
          .trim()
          .toLowerCase() || 'application/octet-stream'
      );
    }

    function validateFiles() {
      const files = Array.from(fileInput?.files || []);
      const totalSize = files.reduce((total, file) => total + file.size, 0);
      const tooLarge = files.find((file) => file.size > 5 * 1024 * 1024);
      const invalidType = files.find((file) => {
        const allowedMimeTypes = allowedFileMimeTypes[getExtension(file.name)];
        return !allowedMimeTypes || !allowedMimeTypes.includes(normalizeMimeType(file.type));
      });

      if (files.length > 3) return 'Attach no more than 3 files.';
      if (tooLarge) return `${tooLarge.name} is larger than 5 MB.`;
      if (totalSize > 8 * 1024 * 1024) return 'Attachments must be 8 MB or less in total.';
      if (invalidType) return `${invalidType.name} uses an unsupported or mismatched file format.`;
      return '';
    }

    fileInput?.addEventListener('change', () => {
      const error = validateFiles();
      fileInput.setCustomValidity(error);
      if (fileHelp) fileHelp.textContent = error || 'Optional. Up to 3 files, 5 MB each, 8 MB total.';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      refreshContext();

      const fileError = validateFiles();
      fileInput?.setCustomValidity(fileError);
      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus(fileError || 'Please complete the required fields.', true);
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Sending RFQ…';
      setStatus('Securely sending your project…');

      try {
        const formData = new FormData(form);
        const consentGiven = formData.get('consent') === 'accepted';
        const submittedEmail = consentGiven ? formData.get('email') : '';
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || result.accepted !== true || !result.submissionId) {
          throw new Error(result.message || 'The RFQ could not be accepted. Please email info@szcomo.com.');
        }

        const trackingPayload = {
          method: 'secure_rfq_form',
          application: form.elements.namedItem('application')?.value || '',
          material: form.elements.namedItem('material')?.value || '',
          timing: form.elements.namedItem('timing')?.value || '',
          has_attachments: Boolean(fileInput?.files?.length),
          attachment_count: fileInput?.files?.length || 0,
          submission_id: result.submissionId,
          transaction_id: result.submissionId,
          event_category: 'rfq_submission',
          page_location: window.location.href,
          page_path: window.location.pathname,
        };

        if (typeof window.TITANIUM3DP_TRACK_EVENT === 'function') {
          window.TITANIUM3DP_TRACK_EVENT('rfq_form_submit_success', trackingPayload, {
            generateLead: true,
            adsConversion: 'rfq_submit',
            conversionKey: `rfq_submit_${result.submissionId}`,
            userData: consentGiven && typeof submittedEmail === 'string' ? { email: submittedEmail } : undefined,
          });
        } else {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'rfq_form_submit_success', ...trackingPayload });
          window.dataLayer.push({ event: 'generate_lead', ...trackingPayload });
        }

        form.classList.add('hidden');
        successPanel?.classList.remove('hidden');
        if (reference) reference.textContent = `Reference: ${result.submissionId}`;
        successPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'The RFQ could not be accepted.', true);
        if (window.turnstile && typeof window.turnstile.reset === 'function') window.turnstile.reset();
        submitButton.disabled = false;
        submitButton.textContent = defaultSubmitText;
      }
    });

    refreshContext(true);
  })();
</script>
