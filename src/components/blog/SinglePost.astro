---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const categoryHref = post.category
  ? post.category.slug === 'case-studies'
    ? getBlogPermalink()
    : getPermalink(post.category.slug, 'category')
  : '';

const postContainerClass = 'mx-auto max-w-5xl px-4 sm:px-6';
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class={post.image ? 'intersect-once intersect-quarter' : 'intersect-once intersect-quarter'}>
      <div class:list={[postContainerClass, 'flex justify-between flex-col sm:flex-row mt-0 mb-2 sm:items-center']}>
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 text-muted" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.author && (
              <>
                {' '}
                - <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 text-muted" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                -{' '}
                <a class="hover:underline inline-block" href={categoryHref}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;- <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1
        class:list={[
          postContainerClass,
          'text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading',
        ]}
      >
        {post.title}
      </h1>
      <p class:list={[postContainerClass, 'mt-4 mb-8 text-xl md:text-2xl text-muted text-justify']}>
        {post.excerpt}
      </p>

      {
        post.image ? (
          <div class={postContainerClass}>
            <Image
              src={post.image}
              class="w-full mb-6 sm:rounded-md bg-surface-raised"
              widths={[400, 768, 1024, 1200, 1536, 2048]}
              sizes="(max-width: 639px) calc(100vw - 32px), (max-width: 1023px) calc(100vw - 48px), 976px"
              alt={post.title}
              width={1200}
              height={675}
              layout="responsive"
              loading="eager"
              decoding="async"
            />
          </div>
        ) : (
          <div class={postContainerClass}>
            <div class="border-t border-page-border" />
          </div>
        )
      }
    </header>
    <div class:list={[postContainerClass, 'mt-8']}>
      <div
        class="prose prose-md max-w-none lg:prose-xl dark:prose-invert dark:prose-headings:text-heading prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-link prose-img:rounded-md prose-img:shadow-lg prose-headings:scroll-mt-[80px] prose-li:my-0"
      >
        <slot />
      </div>
    </div>
    <div class:list={[postContainerClass, 'mt-8 flex justify-between flex-col sm:flex-row']}>
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-muted" />
    </div>
  </article>
</section>
