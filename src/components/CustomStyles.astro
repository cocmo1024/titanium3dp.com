---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(62 88 123);
    --aw-color-secondary: rgb(47 67 96);
    --aw-color-accent: rgb(142 87 50);
    --aw-color-link: rgb(62 88 123);

    --aw-color-text-heading: rgb(17 24 39);
    --aw-color-text-default: rgb(34 43 57);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(91 101 116);
    --aw-color-bg-page: rgb(248 249 250);
    --aw-color-bg-page-dark: rgb(4 6 12);
    --aw-color-surface: rgb(255 255 255);
    --aw-color-surface-raised: rgb(249 250 251);
    --aw-color-border: rgb(221 226 232);

    ::selection {
      background-color: rgb(255 243 234);
      color: rgb(122 53 28);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(130 153 184);
    --aw-color-secondary: rgb(102 121 151);
    --aw-color-accent: rgb(218 158 105);
    --aw-color-link: rgb(169 188 215);

    --aw-color-text-heading: rgb(247 248 244);
    --aw-color-text-default: rgb(215 221 231);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(144 155 171);
    --aw-color-bg-page: rgb(4 6 12);
    --aw-color-bg-page-dark: rgb(4 6 12);
    --aw-color-surface: rgb(12 16 25);
    --aw-color-surface-raised: rgb(17 22 33);
    --aw-color-border: rgb(34 41 55);

    ::selection {
      background-color: rgb(122 53 28);
      color: rgb(255 243 234);
    }
  }
</style>
