---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(63 86 115);
    --aw-color-secondary: rgb(43 61 84);
    --aw-color-accent: rgb(164 106 68);
    --aw-color-link: rgb(54 88 125);
    --aw-color-on-primary: rgb(255 255 255);
    --aw-color-on-accent: rgb(255 255 255);
    --aw-color-whatsapp: rgb(18 140 126);

    --aw-color-text-heading: rgb(14 22 34);
    --aw-color-text-default: rgb(39 49 64);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(97 111 130);
    --aw-color-bg-page: rgb(245 247 250);
    --aw-color-bg-page-dark: rgb(5 7 11);
    --aw-color-surface: rgb(255 255 255);
    --aw-color-surface-raised: rgb(238 242 246);
    --aw-color-border: rgb(214 222 232);
    --aw-color-code-bg: rgb(8 13 20);
    --aw-color-code-text: rgb(238 244 250);

    ::selection {
      background-color: rgb(228 236 246);
      color: rgb(25 38 56);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(169 185 204);
    --aw-color-secondary: rgb(126 147 173);
    --aw-color-accent: rgb(214 160 106);
    --aw-color-link: rgb(185 203 224);
    --aw-color-on-primary: rgb(5 7 11);
    --aw-color-on-accent: rgb(5 7 11);
    --aw-color-whatsapp: rgb(37 211 102);

    --aw-color-text-heading: rgb(246 248 251);
    --aw-color-text-default: rgb(207 216 228);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(145 158 175);
    --aw-color-bg-page: rgb(5 7 11);
    --aw-color-bg-page-dark: rgb(5 7 11);
    --aw-color-surface: rgb(11 16 24);
    --aw-color-surface-raised: rgb(18 26 38);
    --aw-color-border: rgb(39 51 68);
    --aw-color-code-bg: rgb(8 13 20);
    --aw-color-code-text: rgb(240 245 250);

    ::selection {
      background-color: rgb(67 90 120);
      color: rgb(248 250 252);
    }
  }
</style>
