---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import RfqForm from '~/components/forms/RfqForm.astro';
import { contentClusters } from '~/data/content-clusters';
import { fetchPosts } from '~/utils/blog';
import { createFAQSchema, createItemListSchema, createTitaniumServiceSchema } from '~/utils/structured-data';

const posts = await fetchPosts();
const postCount = posts.length;
const sectionClass = 'mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-14 lg:py-16';

const materialRoutes = [
  {
    title: 'TC4 / Ti-6Al-4V / Grade 5',
    description:
      'The primary structural route for high strength-to-weight parts. Normalize the alloy name, condition, process class, and acceptance evidence before comparing quotations.',
    href: '/materials/tc4-ti6al4v-grade-5/',
  },
  {
    title: 'Ti-6Al-4V ELI / Grade 23',
    description:
      'An extra-low-interstitial path for selected fatigue-sensitive, medical-adjacent, or high-reliability work. The material specification does not certify the complete device or part.',
    href: '/materials/ti6al4v-eli-grade-23-astm-f3001/',
  },
  {
    title: 'Grade 2 / TA2 / CP titanium',
    description:
      'A corrosion- and ductility-led route where the exact standard and a qualified supplier AM path must be confirmed rather than inferred from a wrought designation.',
    href: '/materials/grade-2-cp-titanium-ta2-3d-printing/',
  },
];

const applicationRoutes = [
  {
    title: 'Aerospace, space, UAV, and eVTOL',
    description: 'Mass value, fatigue, load path, interfaces, traceability, and design-authority approval.',
    href: '/applications/#flight-mobility',
  },
  {
    title: 'Medical and orthopedic structures',
    description: 'ELI material, porous geometry, cleaning, validation, regulatory, and release boundaries.',
    href: '/applications/#medical',
  },
  {
    title: 'Robotics and high-tech equipment',
    description: 'Moving mass, stiffness, thermal duty, cleanliness, vacuum, and precision interfaces.',
    href: '/applications/#robotics-high-tech',
  },
  {
    title: 'Energy, hydrogen, and pressure parts',
    description: 'Media, temperature, pressure, channels, leak risk, inspection, and code ownership.',
    href: '/applications/#energy-infrastructure',
  },
  {
    title: 'Marine, water, and process equipment',
    description: 'Chemistry, chlorides, erosion, deposits, galvanic design, cleaning, and functional testing.',
    href: '/applications/#corrosion-flow',
  },
  {
    title: 'Motorsport and lightweight mobility',
    description: 'Unsprung or rotating mass, duty cycle, surface condition, event timing, and inspection.',
    href: '/posts/titanium-3d-printing-motorsport-racing-parts/',
  },
];

const processSteps = [
  [
    '01',
    'Screen the business case',
    'Confirm that geometry, mass, consolidation, internal flow, or patient fit creates enough value to justify AM.',
  ],
  [
    '02',
    'Lock the material intent',
    'Name the grade, chemistry, governing specification, delivered condition, and any customer controls.',
  ],
  [
    '03',
    'Review DfAM risk',
    'Plan orientation, supports, thin walls, trapped powder, distortion, machining access, and protected surfaces.',
  ],
  [
    '04',
    'Define the process chain',
    'Sequence printing, stress relief, HIP if justified, support removal, machining, finishing, cleaning, and handling.',
  ],
  [
    '05',
    'Build the evidence plan',
    'Match CMM, CT, NDT, coupons, surface, leak, pressure, and traceability evidence to the actual failure modes.',
  ],
  [
    '06',
    'Issue a comparable RFQ',
    'Send every supplier the same CAD, drawing, quantity, delivery state, acceptance rules, records, and schedule.',
  ],
];

const faqItems = [
  {
    title: 'Which titanium grades can be reviewed?',
    description:
      'Most projects begin with Ti-6Al-4V / TC4 / Grade 5, Ti-6Al-4V ELI / Grade 23, or a controlled commercially pure titanium route such as Grade 1 or Grade 2. Other alloys depend on an available and qualified supplier process.',
  },
  {
    title: 'Is LPBF or EBM the better process?',
    description:
      'The answer depends on geometry, feature scale, thermal behavior, support and powder-removal access, surface and machining requirements, material route, evidence burden, quantity, and supplier qualification. A process name alone is not enough.',
  },
  {
    title: 'Does a titanium material standard certify the finished part?',
    description:
      'No. A material specification supports one layer of the requirement. The drawing, process route, post-processing, inspection technique, acceptance criteria, records, and any regulatory or design-authority approval remain project-specific.',
  },
  {
    title: 'What files produce the fastest useful quote?',
    description:
      'Send STEP or native CAD, a controlled 2D drawing, quantity and lot definition, target material, delivery date, critical datums and surfaces, operating conditions, post-processing, inspection, documentation, and ship-to country.',
  },
  {
    title: 'When should titanium additive manufacturing be rejected?',
    description:
      'Reject or re-route the project when geometry is simple, conventional machining or forging has a clear cost and risk advantage, supports or powder cannot be removed, critical surfaces cannot be finished, or the evidence budget cannot support the required consequence of failure.',
  },
];

const metadata = {
  title: 'Titanium 3D Printing Services for Engineering-Ready Parts',
  ignoreTitleTemplate: true,
  description:
    'Titanium 3D printing services and engineering review for TC4, Ti-6Al-4V, Grade 23 ELI, and CP titanium LPBF or EBM parts, from CAD and DfAM through inspection and RFQ.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/titanium/titanium-hero.webp',
        width: 1200,
        height: 675,
        alt: 'Titanium additive manufacturing parts and lattice structures',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createTitaniumServiceSchema(),
    createItemListSchema(
      'Titanium additive manufacturing engineering decision paths',
      contentClusters.map((cluster) => ({
        name: cluster.title,
        description: cluster.description,
        url: cluster.href,
      }))
    ),
    createFAQSchema(faqItems),
  ],
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-page-border bg-page not-prose">
    <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
      <div class="absolute -right-32 -top-48 h-[34rem] w-[34rem] rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-accent/10 blur-3xl"></div>
    </div>
    <div
      class="relative mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start lg:gap-14 lg:py-20"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">
          Titanium additive manufacturing · Engineering review · Global RFQ
        </p>
        <h1
          class="mt-4 max-w-3xl font-heading text-[2rem] font-semibold leading-[1.08] tracking-tight text-heading sm:text-[2.75rem] lg:text-[2.875rem]"
        >
          Titanium 3D printing <span class="min-[360px]:whitespace-nowrap"
            >for <span class="whitespace-nowrap">engineering-ready</span></span
          >
          parts
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
          Evaluate TC4 / Ti-6Al-4V, Grade 23 ELI, and commercially pure titanium parts from CAD and DfAM through LPBF or
          EBM, thermal processing, machining, inspection, documentation, and delivered-part quotation.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-muted">
          Operated by Suzhou Como Precision Materials Co., Ltd. Supplier-specific equipment, build envelope,
          certification, and final process route are confirmed against the actual RFQ.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href="/rfq/#rfq-form">Submit project RFQ</a>
          <a class="btn-secondary" href="/knowledge/">Explore the knowledge center</a>
        </div>
        <dl class="mt-9 grid max-w-2xl grid-cols-3 gap-px overflow-hidden border-y border-page-border bg-page-border">
          <div class="bg-page px-3 py-4 sm:px-4">
            <dt class="text-xs font-semibold uppercase text-muted">Engineering guides</dt>
            <dd class="mt-1 text-xl font-bold text-heading">{postCount}</dd>
          </div>
          <div class="bg-page px-3 py-4 sm:px-4">
            <dt class="text-xs font-semibold uppercase text-muted">Decision paths</dt>
            <dd class="mt-1 text-xl font-bold text-heading">{contentClusters.length}</dd>
          </div>
          <div class="bg-page px-3 py-4 sm:px-4">
            <dt class="text-xs font-semibold uppercase text-muted">Core PBF routes</dt>
            <dd class="mt-1 text-xl font-bold text-heading">LPBF / EBM</dd>
          </div>
        </dl>
      </div>

      <div class="relative lg:pt-12">
        <div class="overflow-hidden border border-page-border bg-surface sm:rounded-lg">
          <Image
            src="~/assets/images/titanium/titanium-hero.webp"
            width={1672}
            height={941}
            aspectRatio="3/2"
            widths={[640, 960, 1280, 1672]}
            sizes="(max-width: 1023px) calc(100vw - 32px), 610px"
            layout="responsive"
            objectFit="cover"
            alt="Illustrative titanium additive manufacturing parts and lattice structures"
            class="block aspect-[3/2] w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div
          class="border-x border-b border-page-border bg-surface px-4 py-3 text-xs leading-5 text-muted sm:rounded-b-lg"
        >
          Representative titanium AM geometry. Final manufacturability and acceptance depend on the controlled part
          definition and supplier route.
        </div>
      </div>
    </div>
  </section>

  <section class={sectionClass} aria-labelledby="project-fit-title">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-primary">Project fit</p>
        <h2 id="project-fit-title" class="mt-2 font-heading text-3xl font-bold text-heading sm:text-4xl">
          AM must change the part economics or performance
        </h2>
        <p class="mt-4 leading-7 text-muted">
          Titanium is expensive to print and qualify. The route earns its cost when geometry creates system-level value
          and the finished-part evidence can be defined before quotation.
        </p>
      </div>
      <div class="grid gap-px overflow-hidden border-y border-page-border bg-page-border sm:grid-cols-2">
        <div class="bg-page p-6">
          <p class="text-xs font-semibold uppercase text-primary">Strong fit</p>
          <h3 class="mt-2 font-heading text-xl font-semibold text-heading">Geometry carries the value</h3>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-muted">
            <li>Topology-optimized load paths and meaningful mass reduction.</li>
            <li>Internal channels, compact manifolds, lattices, porous or patient-specific structures.</li>
            <li>Part consolidation that removes joints, fasteners, alignment, or failure interfaces.</li>
            <li>Low-to-medium volumes where tooling or conventional access is the constraint.</li>
          </ul>
        </div>
        <div class="bg-page p-6">
          <p class="text-xs font-semibold uppercase text-muted">Weak fit</p>
          <h3 class="mt-2 font-heading text-xl font-semibold text-heading">AM adds cost without removing risk</h3>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-muted">
            <li>Simple plates, blocks, shafts, and open geometry with easy tool access.</li>
            <li>Blanket tight tolerances without machining stock, datums, or inspection access.</li>
            <li>Enclosed powder or supports that cannot be removed and verified.</li>
            <li>High consequence of failure without a qualification and evidence budget.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface" aria-labelledby="materials-title">
    <div class={sectionClass}>
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">Material routes</p>
        <h2 id="materials-title" class="mt-2 font-heading text-3xl font-bold text-heading sm:text-4xl">
          Specify the delivered material state, not only the alloy nickname
        </h2>
        <p class="mt-4 leading-7 text-muted">
          Material identity, AM process, thermal condition, HIP, surface, machining, orientation, sampling, and
          acceptance evidence determine what the quoted part actually represents.
        </p>
      </div>
      <div class="mt-8 grid gap-px overflow-hidden border-y border-page-border bg-page-border lg:grid-cols-3">
        {
          materialRoutes.map((item) => (
            <a class="group bg-page p-6" href={item.href}>
              <h3 class="font-heading text-xl font-semibold text-heading group-hover:text-link">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{item.description}</p>
              <span class="mt-5 inline-flex text-sm font-semibold text-link group-hover:underline">
                Review material path →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class={sectionClass} aria-labelledby="process-chain-title">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-primary">Delivered-part workflow</p>
      <h2 id="process-chain-title" class="mt-2 font-heading text-3xl font-bold text-heading sm:text-4xl">
        Printing is one controlled step in a longer evidence chain
      </h2>
      <p class="mt-4 leading-7 text-muted">
        The quote must connect geometry to the material route, post-processing, finished interfaces, inspection,
        records, and commercial scope. Skipping one gate moves risk downstream.
      </p>
    </div>
    <ol
      class="mt-9 grid gap-px overflow-hidden border-y border-page-border bg-page-border md:grid-cols-2 lg:grid-cols-3"
    >
      {
        processSteps.map(([number, title, description]) => (
          <li class="bg-page p-6">
            <span class="text-sm font-semibold text-primary">{number}</span>
            <h3 class="mt-3 font-heading text-xl font-semibold text-heading">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{description}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-7 flex flex-wrap gap-3">
      <a class="btn-primary" href="/capabilities/">Review manufacturing scope</a>
      <a class="btn-secondary" href="/posts/titanium-am-standards-specifications-f2924-f3001-52948/">
        Map standards to the purchase order
      </a>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface" aria-labelledby="applications-title">
    <div class={sectionClass}>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-14">
        <div>
          <p class="text-sm font-semibold text-primary">Application decisions</p>
          <h2 id="applications-title" class="mt-2 font-heading text-3xl font-bold text-heading sm:text-4xl">
            Industry names do not decide whether a part belongs in AM
          </h2>
          <p class="mt-4 leading-7 text-muted">
            Each path starts with the operating environment and failure mode, then defines the material, geometry,
            evidence, and purchasing output. This avoids generic “Titanium 3D Printing for X” pages.
          </p>
          <div class="mt-6">
            <Image
              src="~/assets/images/titanium/4.webp"
              width={1200}
              height={675}
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) calc(100vw - 32px), 360px"
              alt="Illustrative titanium additive manufacturing application parts"
              class="w-full border border-page-border bg-page sm:rounded-md"
              loading="lazy"
            />
          </div>
        </div>
        <div class="grid border-t border-page-border sm:grid-cols-2">
          {
            applicationRoutes.map((item, index) => (
              <a
                class:list={[
                  'group border-b border-page-border py-5',
                  index % 2 === 0 ? 'sm:pr-6' : 'sm:border-l sm:pl-6',
                ]}
                href={item.href}
              >
                <h3 class="font-heading text-lg font-semibold text-heading group-hover:text-link">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
              </a>
            ))
          }
        </div>
      </div>
      <a class="mt-8 inline-flex text-sm font-semibold text-link hover:underline" href="/applications/">
        Explore the complete application map →
      </a>
    </div>
  </section>

  <section id="engineering-guide" class={sectionClass} aria-labelledby="knowledge-title">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14">
      <div>
        <p class="text-sm font-semibold text-primary">Evidence-led SEO architecture</p>
        <h2 id="knowledge-title" class="mt-2 font-heading text-3xl font-bold text-heading sm:text-4xl">
          One library, six decision paths, no thin tag maze
        </h2>
        <p class="mt-4 leading-7 text-muted">
          The engineering library is inventoried before expansion. A new page must resolve a distinct material, process,
          application, failure, acceptance, or purchasing decision and must connect to a real RFQ path.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-primary" href="/knowledge/">Open knowledge center</a>
          <a class="btn-secondary" href="/case-studies/">Search all guides</a>
        </div>
      </div>
      <div class="grid gap-px overflow-hidden border-y border-page-border bg-page-border sm:grid-cols-2">
        {
          contentClusters.map((cluster) => (
            <a class="group bg-page p-5" href={cluster.href}>
              <p class="text-xs font-semibold uppercase text-primary">
                {cluster.slugs.length} guide{cluster.slugs.length === 1 ? '' : 's'}
              </p>
              <h3 class="mt-2 font-heading text-lg font-semibold text-heading group-hover:text-link">
                {cluster.shortTitle}
              </h3>
              <p class="mt-2 text-sm leading-6 text-muted">{cluster.decision}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <BlogLatestPosts
    title="Latest engineering decisions"
    information="New and updated guides are published for a distinct buyer task, source boundary, and RFQ output—not to inflate page count."
    classes={{ container: 'mx-auto max-w-5xl py-12 sm:py-14 lg:py-16' }}
  />

  <FAQs
    title="Titanium AM quotation questions"
    subtitle="The answers establish a screening boundary. The controlled CAD, drawing, specification, and acceptance plan remain authoritative for a real project."
    tagline="Frequently asked questions"
    classes={{
      container: 'mx-auto max-w-5xl py-12 sm:py-14 lg:py-16',
      headline: { container: 'max-w-3xl text-left md:mx-0' },
    }}
    items={faqItems}
  />

  <RfqForm />
</Layout>
