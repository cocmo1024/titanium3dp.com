---
import Layout from '~/layouts/PageLayout.astro';

import Image from '~/components/common/Image.astro';
import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { createTitaniumServiceSchema, createItemListSchema } from '~/utils/structured-data';

const rfqEmail = 'info@szcomo.com';
const rfqEmailHref = 'mailto:info@szcomo.com';
const heroContainerClass = 'mx-auto max-w-5xl px-4 sm:px-6';
const pageContainerClass = 'mx-auto max-w-5xl px-4 sm:px-6';
const sectionContainerClass = 'max-w-5xl mx-auto py-10 md:py-12 lg:py-14';
const leftHeadlineClasses = {
  container: 'max-w-3xl text-left md:mx-0',
  title: 'text-3xl md:text-4xl font-bold tracking-tight font-heading',
  subtitle: 'text-base leading-7 text-muted md:text-lg',
};

const metadata = {
  title: 'TC4 Titanium 3D Printing Services | Ti-6Al-4V LPBF & EBM Parts',
  ignoreTitleTemplate: true,
  description:
    'TC4 titanium 3D printing services for Ti-6Al-4V, Grade 5, Ti64, Ti-6Al-4V ELI, TA1, TA2, and CP Ti parts. Send CAD for DfAM review, machining, CT/CMM inspection, and RFQ-ready evidence.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/titanium/titanium-hero.webp',
        width: 1200,
        height: 675,
        alt: 'Titanium 3D printing services for LPBF and EBM parts',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createTitaniumServiceSchema(),
    createItemListSchema('Typical titanium additive manufacturing engineering cases', [
      {
        name: 'Titanium AM material selection',
        description:
          'TC4, Ti-6Al-4V Grade 5, Ti64, Ti-6Al-4V ELI Grade 23, TA1, TA2, and CP Ti selection for LPBF and EBM.',
        url: '/materials/',
      },
      {
        name: 'Titanium DfAM rules',
        description: 'Support strategy, overhang limits, thin-wall feasibility, distortion risk, and fatigue control.',
        url: '/posts/titanium-dfam-rules-lpbf-ebm-supports-overhangs-thin-walls/',
      },
      {
        name: 'Titanium AM post-processing',
        description: 'Stress relief, anneal, HIP, machining datums, surface finish, and acceptance planning.',
        url: '/posts/titanium-3d-printing-post-processing-hip-machining-surface-finish/',
      },
      {
        name: 'Titanium AM qualification evidence',
        description: 'CT, CMM, mechanical coupons, density, traceability, and documentation scope.',
        url: '/posts/titanium-am-qualification-inspection-ct-cmm-tensile-coupons/',
      },
    ]),
  ],
};

const applicationShowcases = [
  {
    imagePosition: 'left' as const,
    eyebrow: 'Material gate',
    image: {
      src: '~/assets/images/titanium/1.webp',
      alt: 'Titanium AM material selection - TC4, Ti-6Al-4V, Ti-6Al-4V ELI, TA1, TA2, and CP titanium',
    },
    title: 'Material selection: TC4, Ti-6Al-4V, ELI, and CP Ti',
    description:
      'Worth reviewing when TC4, Ti-6Al-4V, Grade 5, Ti64, TA1, TA2, CP Ti, fatigue risk, corrosion behavior, oxygen limits, or approval pathway drives the part.',
    points: [
      {
        title: 'Alloy route',
        description:
          'Normalize TC4, Ti-6Al-4V, Grade 5, and Ti64 before quote comparison. Use Grade 23 ELI for selected fracture or fatigue needs and TA1/TA2/CP Ti when corrosion or ductility matters.',
      },
      {
        title: 'Evidence intent',
        description:
          'Define certificates, traceability, defect class, coupons, and inspection depth before locking process assumptions.',
      },
      {
        title: 'When to send it',
        description:
          'Send CAD, alloy target, operating environment, load case, quantity, and any acceptance evidence required.',
        callToAction: {
          text: 'Material selection guide',
          href: '/materials/',
        },
      },
    ],
  },
  {
    imagePosition: 'right' as const,
    eyebrow: 'DfAM screen',
    image: {
      src: '~/assets/images/titanium/2.webp',
      alt: 'Titanium DfAM rules for supports, overhangs, thin walls, and distortion control',
    },
    title: 'DfAM rules for supports, overhangs, and distortion',
    description:
      'Best handled before quotation, because support strategy, thermal history, and post-processing access determine whether the part is realistic.',
    points: [
      {
        title: 'Protected faces',
        description:
          'Keep supports away from sealing faces, datums, threads, bores, fatigue surfaces, and cosmetic zones.',
      },
      {
        title: 'Manufacturing limits',
        description:
          'Review thin walls, spans, trapped powder, recoater exposure, downskin quality, and residual-stress risk.',
      },
      {
        title: 'Build strategy',
        description: 'Plan orientation, stress relief, powder removal, supports, and machining access together.',
        callToAction: {
          text: 'Read DfAM guide',
          href: '/posts/titanium-dfam-rules-lpbf-ebm-supports-overhangs-thin-walls/',
        },
      },
    ],
  },
  {
    imagePosition: 'left' as const,
    eyebrow: 'Process chain',
    image: {
      src: '~/assets/images/titanium/3.webp',
      alt: 'Titanium AM post-processing with stress relief, HIP, machining, and surface finishing',
    },
    title: 'Post-processing: stress relief, HIP, machining, finish',
    description:
      'Printing is only one step. The quote should include the thermal route, support removal, datum machining, cleaning, inspection, and release sequence.',
    points: [
      {
        title: 'Thermal route',
        description:
          'Use stress relief, anneal, or HIP according to distortion, density, fatigue, leak, and fracture risk.',
      },
      {
        title: 'Machining access',
        description:
          'Reserve stock and reachable datums for bores, threads, sealing lands, mating surfaces, and functional interfaces.',
      },
      {
        title: 'Release order',
        description: 'Place CT, CMM, cleaning, and coupon checks after operations that can change acceptance risk.',
        callToAction: {
          text: 'Post-processing guide',
          href: '/posts/titanium-3d-printing-post-processing-hip-machining-surface-finish/',
        },
      },
    ],
  },
  {
    imagePosition: 'right' as const,
    eyebrow: 'Application fit',
    image: {
      src: '~/assets/images/titanium/4.webp',
      alt: 'Titanium 3D printing applications for aerospace, motorsport, medical, and energy parts',
    },
    title: 'Applications where LPBF/EBM earn their cost',
    description:
      'Strong candidates usually consolidate parts, reduce mass, add lattices, route internal flow, or create patient-specific and high-strength structures.',
    points: [
      {
        title: 'AM value',
        description:
          'Lightweight brackets, mounts, housings, ducts, porous structures, and compact flow or thermal hardware.',
      },
      {
        title: 'Route logic',
        description: 'Choose LPBF or EBM by wall thickness, support access, surface need, and acceptance evidence.',
      },
      {
        title: 'Weak fit',
        description: 'Simple geometry, flat stock, or cost-only parts often favor CNC, casting, or forging.',
        callToAction: {
          text: 'Application notes',
          href: '/applications/',
        },
      },
    ],
  },
  {
    imagePosition: 'left' as const,
    eyebrow: 'Qualification',
    image: {
      src: '~/assets/images/titanium/5.webp',
      alt: 'Titanium AM qualification evidence with CT, CMM, tensile coupons, density, and documentation',
    },
    title: 'Inspection evidence: CT, CMM, coupons, density',
    description:
      'Approval depends on evidence, not generic process claims. Inspection and documentation should match the actual part risk.',
    points: [
      {
        title: 'Inspection plan',
        description:
          'Use CT for internal features and defect questions; use CMM for datum schemes and functional interfaces.',
      },
      {
        title: 'Evidence scope',
        description:
          'Scale coupons, density checks, certs, build records, and traceability from prototype to critical release.',
      },
      {
        title: 'Acceptance rule',
        description: 'Tie each report to drawing zones, defect class, and the release decision it supports.',
        callToAction: {
          text: 'Qualification guide',
          href: '/posts/titanium-am-qualification-inspection-ct-cmm-tensile-coupons/',
        },
      },
    ],
  },
  {
    imagePosition: 'right' as const,
    eyebrow: 'RFQ package',
    image: {
      src: '~/assets/images/titanium/6.webp',
      alt: 'Titanium AM RFQ and procurement planning for cost, traceability, and deliverables',
    },
    title: 'Procurement: cost drivers, traceability, deliverables',
    description:
      'Quote quality improves when support removal, machining, HIP, inspection, surface condition, lead time, and documents are stated upfront.',
    points: [
      {
        title: 'Cost drivers',
        description: 'Build height, support access, machining stock, HIP, inspection, finish, and documentation depth.',
      },
      {
        title: 'Deliverables',
        description: 'Define powder/build traceability, acceptance criteria, inspection mapping, and report format.',
      },
      {
        title: 'Quote inputs',
        description: 'Send STEP, drawings, quantity, lead time, material intent, finish, and evidence scope.',
        callToAction: {
          text: 'RFQ guide',
          href: '/rfq/',
        },
      },
    ],
  },
  {
    imagePosition: 'left' as const,
    eyebrow: 'No-go screen',
    image: {
      src: '~/assets/images/titanium/7.webp',
      alt: 'When titanium additive manufacturing is not a fit and machining, casting, or forging may be better',
    },
    title: 'When machining, casting, or forging is better',
    description:
      'Simple geometry, blanket tight tolerances, high-volume economics, inaccessible supports, or no evidence budget often point away from AM.',
    points: [
      {
        title: 'Better routes',
        description:
          'Plain plates, blocks, shafts, simple brackets, and easy tool-access parts usually favor CNC or forging.',
      },
      {
        title: 'Early stop',
        description:
          'Avoid AM when support removal, inspection, datum strategy, or acceptance evidence cannot be defined.',
      },
      {
        title: 'Route switch',
        description: 'Move to CNC, casting, or forging when risk cannot be removed or measured cleanly.',
        callToAction: {
          text: 'No-go screening guide',
          href: '/posts/when-not-to-use-titanium-additive-manufacturing/',
        },
      },
    ],
  },
];

const faqItems = [
  {
    title: 'What titanium materials can be reviewed?',
    description:
      'Most RFQs start with Ti-6Al-4V Grade 5, Ti-6Al-4V ELI Grade 23, or CP Ti Grades 1-4. Other grades depend on process route, parameter availability, and evidence needs.',
  },
  {
    title: 'Do I need HIP?',
    description:
      'HIP is usually considered for fatigue, fracture-critical, leak-critical, or density-sensitive parts. It should be tied to risk and acceptance evidence, not used as a generic checkbox.',
  },
  {
    title: 'What files should I send?',
    description:
      'Send STEP or native CAD, drawings with datums and critical features, target alloy, quantity, lead time, surface condition, post-processing, and inspection requirements.',
  },
  {
    title: 'Can titanium AM parts be inspected internally?',
    description:
      'CT inspection can be considered for internal channels, lattices, inaccessible cavities, or defect questions when the requirement is stated before quotation.',
  },
  {
    title: 'When is titanium AM not a good fit?',
    description:
      'Simple geometry, tight all-over tolerances without machining access, inaccessible internal cavities, low evidence budget, or high-volume cost sensitivity may favor machining, casting, or forging.',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative isolate overflow-hidden bg-page not-prose">
    <div class={heroContainerClass}>
      <div class="flex flex-col gap-4 py-4 sm:py-5 lg:py-6">
        <h1 class="sr-only">Titanium 3D printing services for LPBF and EBM parts</h1>
        <div class="relative -mx-4 overflow-hidden border border-page-border bg-surface sm:mx-0 sm:rounded-lg">
          <Image
            src="~/assets/images/titanium/titanium-hero.webp"
            width={1672}
            height={941}
            widths={[]}
            sizes="(max-width: 639px) 100vw, (max-width: 1055px) calc(100vw - 48px), 1024px"
            layout="responsive"
            objectFit="contain"
            alt="Titanium 3D printed structures and lattice components for industrial additive manufacturing"
            class="block w-full sm:rounded-lg"
            loading="eager"
          />
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a class="btn-primary" href={rfqEmailHref}>Email RFQ</a>
          <a class="btn-secondary" href="/rfq/"> Prepare RFQ inputs </a>
        </div>
      </div>
    </div>
  </section>

  <Note
    title="For a faster quote:"
    description="Send CAD or drawings, quantity, material target, lead time, critical surfaces, operating conditions, post-processing, and inspection requirements such as CMM, CT, tensile coupons, COA/COC, or traceability."
  />

  <section class:list={['relative not-prose', sectionContainerClass]}>
    <div class={pageContainerClass}>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-md border border-page-border bg-surface p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">Good fit</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-heading">
            Titanium AM is worth quoting when geometry drives value.
          </h2>
          <ul class="mt-4 space-y-2 text-muted">
            <li>
              Lightweight structures, topology-optimized brackets, mounts, housings, ducts, and compact assemblies.
            </li>
            <li>
              Porous, lattice, internal-flow, patient-specific, or high-strength parts where machining is limiting.
            </li>
            <li>
              Projects where reduced mass, integrated geometry, fewer joints, or fast iteration reduces system risk.
            </li>
          </ul>
        </div>
        <div class="rounded-md border border-page-border bg-surface p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-muted">Usually not a fit</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-heading">
            Simple titanium stock is often better made another way.
          </h2>
          <ul class="mt-4 space-y-2 text-muted">
            <li>Plain plates, blocks, shafts, simple brackets, large billets, or parts with easy CNC access.</li>
            <li>Cost-only requests where AM adds no mass, assembly, thermal, or performance advantage.</li>
            <li>Projects where support removal, datum strategy, or acceptance evidence cannot be defined.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Features3
    title="What to send for review"
    subtitle="A simple drawing may be enough for a basic quote. Critical titanium parts need clearer operating and inspection requirements."
    columns={3}
    classes={{
      container: sectionContainerClass,
      headline: leftHeadlineClasses,
      items: {
        container: 'gap-x-12',
        panel: 'max-w-none',
      },
    }}
    items={[
      {
        title: 'Drawing package',
        description:
          'STEP, X_T, native CAD, or drawings with key dimensions, datum faces, bores, threads, critical surfaces, and GD&T intent.',
        icon: 'tabler:search',
      },
      {
        title: 'Quantity and timing',
        description:
          'Prototype quantity, batch size, target delivery date, approval timing, and any purchasing constraints.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Special requirements',
        description:
          'Material, fatigue, load, temperature, corrosion, HIP, machining, surface finish, CT, CMM, coupons, and traceability when they matter.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  />

  <SplitShowcase
    id="engineering-guide"
    tagline="Engineering guide"
    title="Typical titanium AM cases worth reviewing"
    subtitle="The strongest projects use additive manufacturing to solve lightweighting, internal geometry, lattice, process-chain, qualification, or procurement-risk problems."
    items={applicationShowcases}
    classes={{ container: sectionContainerClass, headline: leftHeadlineClasses }}
  />

  <Features2
    title="What we review before quoting"
    subtitle="The review depth depends on part complexity, drawing quality, and the evidence package required for acceptance."
    tagline="Engineering review"
    classes={{ container: sectionContainerClass, headline: leftHeadlineClasses }}
    items={[
      {
        title: 'DfAM manufacturability',
        description:
          'Wall thickness, supports, overhangs, trapped powder, orientation, support access, and distortion risk.',
        icon: 'tabler:tools',
      },
      {
        title: 'Material and fatigue risk',
        description:
          'Alloy grade, oxygen limits, fracture sensitivity, corrosion, operating temperature, load path, and notch-sensitive surfaces.',
        icon: 'tabler:activity-heartbeat',
      },
      {
        title: 'Post-processing plan',
        description:
          'Stress relief, anneal, HIP, support removal, machining stock, datum strategy, surface finish, and cleaning.',
        icon: 'tabler:settings',
      },
      {
        title: 'Inspection package',
        description:
          'CMM, CT, tensile coupons, density checks, surface roughness, material certs, build records, and traceability when required.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  />

  <BlogLatestPosts
    title="Engineering resources"
    information="Use these notes to prepare RFQs for process selection, alloy selection, DfAM, post-processing, inspection evidence, procurement deliverables, and no-go screening."
    classes={{ container: sectionContainerClass }}
  />

  <FAQs
    title="Frequently asked questions"
    subtitle="Common questions before quoting titanium LPBF or EBM parts."
    tagline="FAQs"
    classes={{ container: sectionContainerClass, headline: leftHeadlineClasses }}
    items={faqItems}
  />

  <Stats
    classes={{
      container: sectionContainerClass,
      stats: {
        container: 'grid grid-cols-1 gap-4 text-left md:grid-cols-4',
        item: 'min-w-0 rounded-md border border-page-border bg-surface p-5 text-left md:w-auto md:border-r',
        amount: 'text-3xl lg:text-4xl xl:text-5xl',
        title: 'mt-2 text-xs',
      },
    }}
    stats={[
      { title: 'Engineering cases', amount: '7' },
      { title: 'Core titanium routes', amount: '3' },
      { title: 'Quote inputs reviewed', amount: '8+' },
      { title: 'Evidence routes', amount: '4+' },
    ]}
  />

  <CallToAction
    classes={{
      container: sectionContainerClass,
      panel: 'max-w-none mx-0 p-7 text-left sm:p-8 md:p-10 lg:p-12',
      headline: {
        container: 'mb-0 max-w-4xl text-left md:mx-0 md:mb-0',
        title: 'text-3xl font-bold tracking-tight font-heading md:text-4xl',
        subtitle: 'mt-5 max-w-4xl text-base leading-7 text-muted md:text-lg md:leading-8',
      },
      actions: 'mx-0 mt-6 sm:justify-start',
    }}
    actions={[
      {
        variant: 'primary',
        text: 'Email info@szcomo.com',
        href: rfqEmailHref,
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Send drawings, quantity, and titanium requirements.</Fragment>

    <Fragment slot="subtitle">
      Email <a class="font-semibold underline underline-offset-4" href={rfqEmailHref}>{rfqEmail}</a> with the drawing, alloy
      target, quantity, lead time, critical dimensions, datum scheme, load, temperature, environment constraints, and required
      inspection evidence.
    </Fragment>
  </CallToAction>
</Layout>
