---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <section class="flex items-center h-full p-16">
    <div class="flex max-w-5xl flex-col items-center justify-center px-4 md:px-6 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-3xl font-semibold md:text-3xl">Sorry, we couldn't find this titanium AM page.</p>
        <p class="mt-4 mb-8 text-lg text-muted">
          Start from the homepage, knowledge center, application map, or secure RFQ page.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={getHomePermalink()} class="btn-primary">Back to homepage</a>
          <a href="/knowledge/" class="btn-secondary">Open knowledge center</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
