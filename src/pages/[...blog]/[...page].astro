---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import IntentLibrary from '~/components/blog/IntentLibrary.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, fetchPosts, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const allPosts = currentPage === 1 ? await fetchPosts() : [];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Titanium AM Engineering Guides${currentPage > 1 ? ` | Page ${currentPage}` : ''}`,
  description:
    'Titanium AM engineering guides for material selection, DfAM, post-processing, inspection, qualification, applications, cost, and RFQ preparation.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Engineering Guides', item: getBlogPermalink() },
    ]),
    createItemListSchema(
      `Titanium AM engineering guides${currentPage > 1 ? ` page ${currentPage}` : ''}`,
      (currentPage === 1 ? allPosts : page.data).map((post) => ({
        name: post.title,
        description: post.excerpt,
        url: getPermalink(post.permalink, 'post'),
      }))
    ),
  ],
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-5xl">
    <Headline
      subtitle="Browse the complete evidence-led library by engineering decision. Search material and process selection, DfAM, inspection, application fit, and procurement-ready RFQ guidance."
    >
      Titanium AM Engineering Guides
    </Headline>
    <p class="mb-8 text-sm leading-6 text-muted">
      Evaluating a real part?
      <a class="font-semibold text-link underline-offset-4 hover:underline" href={getPermalink('/rfq/#rfq-form')}>
        Send CAD and requirements for a manufacturability review
      </a>
      .
    </p>
    {
      currentPage === 1 ? (
        <IntentLibrary posts={allPosts} />
      ) : (
        <>
          <BlogList posts={page.data} />
          <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
        </>
      )
    }
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
</Layout>
