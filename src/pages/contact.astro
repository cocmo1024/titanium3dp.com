---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { createBreadcrumbSchema } from '~/utils/structured-data';

const sectionContainerClass = 'py-10 md:py-12 lg:py-14';
const rfqEmailHref = 'mailto:info@szcomo.com?subject=TITANIUM%203DP%20general%20inquiry';

const metadata = {
  title: 'Contact Us | Engineering and RFQ Questions',
  description:
    'Contact TITANIUM 3DP for company, engineering-content, privacy, or general questions. Submit titanium additive manufacturing projects through the secure RFQ form.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/titanium/titanium-hero.webp',
        width: 1200,
        height: 675,
        alt: 'Contact TITANIUM 3DP',
      },
    ],
    type: 'website',
  },
  structuredData: createBreadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Contact', item: '/contact/' },
  ]),
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Contact TITANIUM 3DP"
    subtitle="Use the secure RFQ form for CAD, drawings, and quotation requests. Use email for company, content correction, privacy, partnership, or other general questions."
  />

  <CallToAction
    id="form"
    classes={{ container: sectionContainerClass }}
    title="Choose the channel that matches the request"
    subtitle="The secure form creates a submission reference and keeps project requirements structured. General email is the fallback for non-project questions or when online submission is unavailable."
    actions={[
      {
        variant: 'primary',
        text: 'Submit secure RFQ',
        href: '/rfq/#rfq-form',
        icon: 'tabler:file-upload',
      },
      {
        text: 'Email general inquiry',
        href: rfqEmailHref,
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
