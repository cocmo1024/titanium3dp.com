---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import Layout from '~/layouts/PageLayout.astro';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

const sectionContainerClass = 'py-10 md:py-12 lg:py-14';

const applicationShowcases = [
  {
    imagePosition: 'left' as const,
    image: {
      src: '~/assets/images/titanium/4.webp',
      alt: 'TC4 and Ti-6Al-4V titanium 3D printed aerospace, motorsport, medical, and energy applications',
    },
    title: 'TC4 and Ti-6Al-4V weight reduction that changes system behavior',
    description:
      'TC4, Ti-6Al-4V, Grade 5, and Ti64 AM are strongest when mass reduction improves flight, vehicle, robot, or rotating-system behavior and the fatigue/evidence burden is planned from the start.',
    points: [
      {
        title: 'Topology-optimized structures',
        description: 'Organic load paths, variable sections, hollow structures, and stiffness-to-weight optimization.',
      },
      {
        title: 'Part consolidation',
        description:
          'Eliminate fasteners, overlaps, joints, and assembly interfaces when repairability and qualification burden are acceptable.',
      },
      {
        title: 'Qualification boundary',
        description:
          'The cost and schedule only work when inspection, surface finish, and fatigue evidence are aligned with risk.',
        callToAction: {
          text: 'Weight reduction case guide',
          href: '/posts/titanium-additive-manufacturing-components-2026/',
        },
      },
    ],
  },
  {
    imagePosition: 'right' as const,
    image: {
      src: '~/assets/images/titanium/7.webp',
      alt: 'TC4 titanium additive manufacturing application screening and RFQ rules',
    },
    title: 'Application screening before quotation',
    description:
      'Not every titanium part belongs in AM. Screen the application around geometry value, load case, machining access, evidence budget, and procurement approval path.',
    points: [
      {
        title: 'Good fit',
        description:
          'Complex load paths, internal channels, compact assemblies, patient-specific forms, and high value per kilogram saved.',
      },
      {
        title: 'Weak fit',
        description:
          'Simple stock-like geometry, high-volume cost pressure, high fatigue claims with low evidence budget, or inaccessible supports.',
      },
      {
        title: 'RFQ decision',
        description:
          'A useful quote connects application outcome to process route, finishing, inspection, documentation, and lead time.',
        callToAction: {
          text: 'No-go screening guide',
          href: '/posts/when-not-to-use-titanium-additive-manufacturing/',
        },
      },
    ],
  },
];

const applicationClusters = [
  {
    id: 'flight-mobility',
    title: 'Flight, space, and lightweight mobility',
    summary:
      'Start with mass value, load path, fatigue exposure, interfaces, and the evidence required by the design authority.',
    items: [
      {
        title: 'Aerospace and defense supply chains',
        description: 'Alternate sourcing, near-net blanks, bridge production, and controlled qualification boundaries.',
        href: '/posts/titanium-3d-printing-aerospace-defense-supply-chain-resilience/',
      },
      {
        title: 'Spacecraft and satellite components',
        description: 'Mass, stiffness, thermal, contamination, launch-load, and mission-documentation decisions.',
        href: '/posts/titanium-3d-printing-spacecraft-satellite-components/',
      },
      {
        title: 'eVTOL and advanced air mobility hardware',
        description: 'Structural efficiency, route maturity, fatigue, interfaces, and certification ownership.',
        href: '/posts/titanium-3d-printing-evtol-advanced-air-mobility-hardware/',
      },
      {
        title: 'Drone and UAV parts',
        description:
          'Payload mounts, sensor hardware, motor junctions, vibration, thermal exposure, and repairability.',
        href: '/posts/titanium-3d-printing-drone-uav-parts/',
      },
      {
        title: 'Motorsport and racing parts',
        description: 'Unsprung or rotating mass, rule boundaries, duty cycle, inspection, and event lead time.',
        href: '/posts/titanium-3d-printing-motorsport-racing-parts/',
      },
    ],
  },
  {
    id: 'medical',
    title: 'Medical and patient-specific structures',
    summary:
      'Separate geometry feasibility from device regulation, validated material condition, cleaning, packaging, and release authority.',
    items: [
      {
        title: 'Medical device and orthopedic implant parts',
        description:
          'ELI material routes, porous geometry, patient-specific forms, validation, and regulatory boundaries.',
        href: '/posts/titanium-3d-printing-medical-device-orthopedic-implant-parts/',
      },
    ],
  },
  {
    id: 'robotics-high-tech',
    title: 'Robotics and high-technology equipment',
    summary:
      'Translate equipment-level goals into stiffness, moving mass, heat, cleanliness, vacuum, and maintainability requirements.',
    items: [
      {
        title: 'Robotics and automation parts',
        description: 'End effectors, arms, tool-center-point behavior, payload, cycle life, and service interfaces.',
        href: '/posts/titanium-3d-printing-robotics-automation-parts/',
      },
      {
        title: 'Humanoid robot hardware',
        description: 'Actuator housings, wrists, sensor mounts, lightweight limbs, repeated loads, and cost limits.',
        href: '/posts/titanium-3d-printing-humanoid-robots-ai-robotics-hardware/',
      },
      {
        title: 'Semiconductor equipment parts',
        description: 'Cleanliness, process exposure, vacuum, thermal stability, finishing, and contamination control.',
        href: '/posts/titanium-3d-printing-semiconductor-equipment-parts/',
      },
      {
        title: 'Quantum and cryogenic hardware',
        description: 'Temperature stages, vacuum, thermal conduction, cable routing, cleaning, and leak testing.',
        href: '/posts/titanium-3d-printing-quantum-computing-cryogenic-hardware/',
      },
      {
        title: 'AI data-center liquid cooling',
        description: 'Thermal duty, coolant compatibility, pressure, leak acceptance, channels, and serviceability.',
        href: '/posts/titanium-3d-printing-ai-data-center-liquid-cooling-hardware/',
      },
    ],
  },
  {
    id: 'energy-infrastructure',
    title: 'Energy and critical infrastructure',
    summary:
      'Define the actual fluid, atmosphere, temperature, pressure, lifetime, code boundary, and inspection owner before selecting titanium AM.',
    items: [
      {
        title: 'Fusion and nuclear research hardware',
        description:
          'Vacuum, cooling, activation context, research-stage controls, joining, inspection, and release authority.',
        href: '/posts/titanium-3d-printing-fusion-nuclear-research-hardware/',
      },
      {
        title: 'Hydrogen, electrolyzer, and fuel-cell parts',
        description:
          'Media exposure, porous or flow geometry, cleanliness, leak control, and validated material state.',
        href: '/posts/titanium-3d-printing-hydrogen-electrolyzer-fuel-cell-parts/',
      },
      {
        title: 'Geothermal and downhole parts',
        description: 'Brine chemistry, temperature, pressure, erosion, scale, sealing, and retrieval constraints.',
        href: '/posts/titanium-3d-printing-geothermal-downhole-energy-parts/',
      },
      {
        title: 'Oil, gas, LNG, and petrochemical hardware',
        description:
          'Service environment, operator specifications, pressure boundary, NDT, traceability, and route approval.',
        href: '/posts/titanium-3d-printing-oil-gas-lng-petrochemical-hardware/',
      },
      {
        title: 'Carbon capture and direct-air-capture hardware',
        description: 'Media maps, pressure or vacuum, thermal cycling, corrosion, leak limits, and cleaning access.',
        href: '/posts/titanium-3d-printing-carbon-capture-direct-air-capture-hardware/',
      },
    ],
  },
  {
    id: 'corrosion-flow',
    title: 'Corrosion, water, thermal, and flow hardware',
    summary:
      'Do not select titanium from an industry label alone: specify the chemistry, pressure, temperature, erosion, galvanic interfaces, and acceptance test.',
    items: [
      {
        title: 'Chemical processing and water treatment',
        description: 'Exposure maps, alloy choice, crevices, joining, pressure, cleaning, and inspection scope.',
        href: '/posts/titanium-3d-printing-chemical-processing-water-treatment-parts/',
      },
      {
        title: 'Seawater desalination and brine concentration',
        description:
          'Chlorides, concentration, temperature, deposits, galvanic interfaces, pressure, and leak testing.',
        href: '/posts/titanium-3d-printing-seawater-desalination-brine-concentration-hardware/',
      },
      {
        title: 'Marine, subsea, and offshore parts',
        description:
          'Seawater exposure, hydrostatic pressure, galvanic design, sealing, retrieval, and subsea acceptance.',
        href: '/posts/titanium-3d-printing-marine-subsea-offshore-parts/',
      },
      {
        title: 'Hydraulic manifolds and fluid power',
        description:
          'Pressure circuits, cross-drill replacement, support and powder removal, CT, machining, and proof tests.',
        href: '/posts/titanium-3d-printing-hydraulic-manifolds-fluid-power-components/',
      },
      {
        title: 'Valves, pumps, and flow-control hardware',
        description: 'Media, pressure, erosion, sealing faces, machining, NDT, leak testing, and supplier comparison.',
        href: '/posts/titanium-3d-printing-industrial-valves-pump-flow-control-hardware/',
      },
      {
        title: 'Heat exchangers and thermal management',
        description: 'Thermal duty, pressure drop, wall integrity, powder removal, CT, leak testing, and cleanability.',
        href: '/posts/titanium-3d-printed-heat-exchangers-thermal-management/',
      },
    ],
  },
  {
    id: 'critical-minerals',
    title: 'Critical-minerals and process-development hardware',
    summary:
      'Use titanium only after the process stream and failure mode are defined; experimental fixtures and production pressure hardware require different evidence.',
    items: [
      {
        title: 'Battery recycling and critical minerals',
        description: 'Leach chemistry, sampling, test fixtures, valves, manifolds, erosion, and scale-up boundaries.',
        href: '/posts/titanium-3d-printing-battery-recycling-critical-minerals-parts/',
      },
      {
        title: 'Direct lithium extraction and brine processing',
        description: 'Brine chemistry, sorbent interfaces, sampling, sensor hardware, corrosion, and pressure scope.',
        href: '/posts/titanium-3d-printing-direct-lithium-extraction-brine-processing-hardware/',
      },
      {
        title: 'Mining, mineral processing, and hydrometallurgy',
        description: 'Acid leach, slurry, erosion, dosing, sensing, corrosion fixtures, and acceptance evidence.',
        href: '/posts/titanium-3d-printing-mining-mineral-processing-hydrometallurgy-hardware/',
      },
    ],
  },
];

const metadata = {
  title: 'Titanium 3D Printing Applications | Engineering Guides',
  description:
    'Evaluate titanium 3D printing applications across aerospace, medical, robotics, energy, corrosion, flow, thermal, and critical-minerals hardware before RFQ.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/titanium/4.webp',
        width: 1200,
        height: 628,
        alt: 'TC4 and Ti-6Al-4V titanium 3D printing applications',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Applications', item: '/applications/' },
    ]),
    createItemListSchema(
      'Titanium AM application engineering guides',
      applicationClusters.flatMap((cluster) =>
        cluster.items.map((item) => ({
          name: item.title,
          description: item.description,
          url: item.href,
        }))
      )
    ),
  ],
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Applications"
    title="Use TC4 titanium AM where geometry changes the outcome"
    subtitle="Titanium additive manufacturing earns its cost when TC4 / Ti-6Al-4V lightweighting, TA1 / TA2 corrosion-oriented hardware, part consolidation, internal geometry, or patient-specific form changes system performance enough to justify qualification and evidence."
    actions={[
      {
        variant: 'primary',
        text: 'Submit application review',
        href: '/rfq/?project=application-review#rfq-form',
      },
      { text: 'RFQ inputs', href: '/rfq/' },
    ]}
    image={{
      src: '~/assets/images/titanium/4.webp',
      alt: 'TC4 and Ti-6Al-4V titanium 3D printing application parts',
      class: 'mx-auto w-full',
    }}
  />

  <Features2
    title="Application families"
    subtitle="Start from the part function, failure mode, and material name before choosing TC4 / Ti-6Al-4V LPBF, EBM, machining, casting, or forging."
    columns={3}
    items={[
      {
        title: 'Aerospace lightweighting',
        description:
          'TC4 / Ti-6Al-4V brackets, mounts, ducts, housings, and secondary structures where load-path geometry and evidence packages can justify AM.',
        icon: 'tabler:plane',
      },
      {
        title: 'Motorsport and robotics',
        description:
          'End effectors, arms, mounts, and powertrain-adjacent structures where dynamic response improves when mass is removed.',
        icon: 'tabler:engine',
      },
      {
        title: 'Medical structures',
        description:
          'ELI material routes, porous surfaces, patient-specific geometry, and validation scope for medical-adjacent use cases.',
        icon: 'tabler:medical-cross',
      },
      {
        title: 'Energy and flow components',
        description:
          'High-strength TC4 housings, TA1 / TA2 corrosion-oriented hardware, internal channels, thermal/flow structures, and compact titanium assemblies.',
        icon: 'tabler:flame',
      },
      {
        title: 'Part consolidation',
        description:
          'Fewer fasteners, lower assembly mass, integrated interfaces, and reduced alignment stack-ups when qualification burden is acceptable.',
        icon: 'tabler:components',
      },
      {
        title: 'When to avoid AM',
        description:
          'Simple geometry, all-over tight tolerances, no evidence budget, or high-volume cost sensitivity may favor conventional routes.',
        icon: 'tabler:alert-triangle',
      },
    ]}
  />

  <SplitShowcase
    title="Application-specific review"
    subtitle="Use the actual system benefit to decide whether titanium AM is worth quoting."
    tagline="Where AM can help"
    items={applicationShowcases}
    classes={{ container: sectionContainerClass }}
  />

  <Features3
    title="Application deep dives"
    subtitle="Use these guides to connect an application idea to the manufacturing route, evidence burden, and purchasing path."
    columns={3}
    items={[
      {
        title: 'Drone and UAV parts',
        description:
          'Review TC4 / Ti-6Al-4V AM for payload mounts, sensor brackets, motor junctions, thermal-adjacent hardware, vibration risk, and RFQ evidence.',
        icon: 'tabler:drone',
        callToAction: {
          text: 'Read UAV parts guide',
          href: '/posts/titanium-3d-printing-drone-uav-parts/',
        },
      },
      {
        title: 'Aerospace and defense supply chains',
        description:
          'Evaluate titanium AM as an alternate supply route for lightweight structures, near-net blanks, bridge production, and qualified sourcing.',
        icon: 'tabler:plane-tilt',
        callToAction: {
          text: 'Read supply-chain guide',
          href: '/posts/titanium-3d-printing-aerospace-defense-supply-chain-resilience/',
        },
      },
      {
        title: 'Application fit map',
        description:
          'Compare aerospace, motorsport, medical-adjacent, energy, flow, and consolidation cases before committing to TC4, ELI, TA1, TA2, or CP titanium AM.',
        icon: 'tabler:layout-grid',
        callToAction: {
          text: 'Read application guide',
          href: '/posts/titanium-3d-printing-applications-aerospace-medical-motorsport-energy/',
        },
      },
      {
        title: 'Internal channels and manifolds',
        description:
          'Plan powder removal, CT inspection, pressure testing, cleaning access, and acceptance criteria for enclosed flow paths.',
        icon: 'tabler:route',
        callToAction: {
          text: 'Read channel guide',
          href: '/posts/titanium-3d-printed-internal-channels-powder-removal-ct/',
        },
      },
      {
        title: 'Fatigue-sensitive lightweight parts',
        description:
          'Connect weight reduction to surface finish, support scars, HIP decisions, coupons, CT, and route-specific acceptance evidence.',
        icon: 'tabler:activity-heartbeat',
        callToAction: {
          text: 'Read fatigue guide',
          href: '/posts/titanium-3d-printing-fatigue-design-surface-finish-hip/',
        },
      },
    ]}
    classes={{ container: sectionContainerClass }}
  />

  <section class="px-4 md:px-6 py-10 md:py-12 lg:py-14 mx-auto max-w-5xl" aria-labelledby="application-library-title">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">Application library</p>
      <h2 id="application-library-title" class="mt-2 text-3xl font-bold tracking-tight text-heading md:text-4xl">
        Find the engineering decision, not another application slogan
      </h2>
      <p class="mt-4 text-lg leading-8 text-muted">
        These existing guides are grouped by the requirement that drives the quote. Use them to define the operating
        environment, failure mode, evidence burden, and RFQ inputs before deciding whether titanium AM is justified.
      </p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        applicationClusters.map((cluster) => (
          <article id={cluster.id} class="rounded-lg border border-page-border bg-surface-raised p-5 sm:p-6">
            <h3 class="text-xl font-bold text-heading">{cluster.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{cluster.summary}</p>
            <ul class="mt-5 space-y-4">
              {cluster.items.map((item) => (
                <li>
                  <a class="group block" href={item.href}>
                    <strong class="text-heading underline-offset-4 group-hover:text-link group-hover:underline">
                      {item.title}
                    </strong>
                    <span class="mt-1 block text-sm leading-6 text-muted">{item.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CallToAction
    classes={{ container: sectionContainerClass }}
    actions={[
      {
        variant: 'primary',
        text: 'Submit project RFQ',
        href: '/rfq/#rfq-form',
      },
    ]}
    title="Need a TC4 titanium AM application review?"
    subtitle="Send CAD, target alloy name such as TC4, Ti-6Al-4V, Grade 5, Ti64, ELI, TA1, TA2, or CP Ti, plus quantity, lead time, load case, operating environment, critical dimensions, post-processing needs, and inspection requirements."
  />
</Layout>
