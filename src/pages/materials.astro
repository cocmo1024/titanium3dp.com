---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import SplitShowcase from '~/components/widgets/SplitShowcase.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

const sectionContainerClass = 'py-10 md:py-12 lg:py-14';

const materialShowcases = [
  {
    imagePosition: 'left' as const,
    image: {
      src: '~/assets/images/titanium/1.webp',
      alt: 'Titanium material selection for LPBF and EBM additive manufacturing',
    },
    title: 'Material selection should follow the risk class',
    description:
      'Titanium AM material choice depends on fatigue sensitivity, ductility, temperature, corrosion, oxygen control, evidence level, and whether the part is a prototype or a production-intent component.',
    points: [
      {
        title: 'Define the standard',
        description:
          'State the alloy grade and any ASTM, AMS, ISO, or customer specification instead of relying on an informal material name.',
      },
      {
        title: 'Match post-processing',
        description:
          'Stress relief, anneal, solution/aging, HIP, machining, and surface finishing can materially change acceptance assumptions.',
      },
      {
        title: 'Tie evidence to risk',
        description:
          'Material COA, build records, coupons, CMM, CT, and traceability should scale with the part consequence.',
      },
    ],
  },
];

const metadata = {
  title: 'Titanium AM Materials | TC4, Grade 5, Grade 23 & Grade 2',
  description:
    'Titanium additive manufacturing material selection for TC4, Ti-6Al-4V Grade 5, Grade 23 ELI, Grade 2, TA2, TA2G, and CP titanium LPBF or EBM parts.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/titanium/1.webp',
        width: 1200,
        height: 628,
        alt: 'Titanium AM material selection guide',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([
      { name: 'Home', item: '/' },
      { name: 'Materials', item: '/materials/' },
    ]),
    createItemListSchema('Titanium AM material paths', [
      {
        name: 'TC4 / Ti-6Al-4V Grade 5',
        description: 'General high strength-to-weight titanium alloy route for structural LPBF and EBM parts.',
        url: '/materials/tc4-ti6al4v-grade-5/',
      },
      {
        name: 'Ti-6Al-4V ELI Grade 23',
        description:
          'Extra-low interstitial material path for fatigue-sensitive, medical-adjacent, and high-reliability parts.',
        url: '/materials/ti6al4v-eli-grade-23-astm-f3001/',
      },
      {
        name: 'Grade 2 / TA2 / TA2G / CP Titanium',
        description:
          'Commercially pure titanium AM feasibility and RFQ path for corrosion-driven or controlled unalloyed titanium requirements.',
        url: '/materials/grade-2-cp-titanium-ta2-3d-printing/',
      },
    ]),
  ],
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Materials"
    title="Titanium materials for additive manufacturing"
    subtitle="Start with the required function, risk class, and evidence level. Then choose TC4 / Ti-6Al-4V Grade 5, Ti-6Al-4V ELI Grade 23, Grade 2 / TA2 / TA2G commercially pure titanium, or a special material route as needed."
    actions={[
      {
        variant: 'primary',
        text: 'Submit material review',
        href: '/rfq/?project=material-review#rfq-form',
      },
      { text: 'RFQ inputs', href: '/rfq/' },
    ]}
    image={{
      src: '~/assets/images/titanium/1.webp',
      alt: 'TC4, Ti-6Al-4V, TA1, TA2, and CP titanium additive manufacturing material review',
      class: 'mx-auto w-full',
    }}
  />

  <Features2
    title="Common titanium AM material paths"
    subtitle="The right grade is selected against fatigue risk, ductility, oxygen control, corrosion exposure, documentation expectations, and the actual material name used in the RFQ."
    columns={3}
    items={[
      {
        title: 'TC4 / Ti-6Al-4V Grade 5',
        description:
          'Common for strength-to-weight structural parts, brackets, housings, mounts, and performance hardware. TC4, Ti-6Al-4V, Grade 5, and Ti64 should be normalized before quote comparison.',
        icon: 'tabler:hexagon-letter-t',
        callToAction: {
          text: 'Review TC4 / Grade 5 route',
          href: '/materials/tc4-ti6al4v-grade-5/',
        },
      },
      {
        title: 'Ti-6Al-4V ELI Grade 23',
        description:
          'ASTM F3001 powder bed fusion route for extra-low-interstitial Ti-6Al-4V when tighter chemistry and application-specific evidence matter.',
        icon: 'tabler:atom',
        callToAction: {
          text: 'Review Grade 23 / F3001 route',
          href: '/materials/ti6al4v-eli-grade-23-astm-f3001/',
        },
      },
      {
        title: 'Grade 2 / TA2 / TA2G / CP Titanium',
        description:
          'Reviewed where corrosion behavior, ductility, or a controlled commercially pure titanium requirement matters more than maximum strength. Confirm the exact standard and supplier AM route.',
        icon: 'tabler:shield-check',
        callToAction: {
          text: 'Review Grade 2 / TA2 route',
          href: '/materials/grade-2-cp-titanium-ta2-3d-printing/',
        },
      },
    ]}
  />

  <SplitShowcase items={materialShowcases} classes={{ container: sectionContainerClass }} />

  <CallToAction
    classes={{ container: sectionContainerClass }}
    title="Not sure which titanium grade fits the part?"
    subtitle="Send CAD, drawings, operating environment, load spectrum, temperature, corrosion or biocompatibility constraints, quantity, and required evidence package."
    actions={[
      {
        variant: 'primary',
        text: 'Submit drawing for review',
        href: '/rfq/?project=material-review#rfq-form',
      },
    ]}
  />
</Layout>
