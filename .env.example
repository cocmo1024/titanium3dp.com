# Google tag / Google Ads conversion tracking.
# Fill these in Cloudflare or GitHub build environment variables, not in source control.
PUBLIC_GOOGLE_TAG_ID=
PUBLIC_GOOGLE_TAG_MANAGER_ID=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_ADS_CONVERSION_ID=
PUBLIC_GOOGLE_ADS_RFQ_CONVERSION_LABEL=
PUBLIC_GOOGLE_ADS_RFQ_SUBMIT_CONVERSION_LABEL=
PUBLIC_GOOGLE_SITE_VERIFICATION_ID=

# Secure RFQ form. Set the public key in the build environment and keep the
# matching secret encrypted in the Cloudflare Worker runtime.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
